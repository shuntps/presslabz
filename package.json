{
  "name": "presslabz",
  "version": "0.0.0",
  "private": true,
  "description": "A modern, secure and fast content management system",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint:unused": "knip",
    "lint:manifests": "node --test \"scripts/**/*.test.mjs\"",
    "e2e": "pnpm --filter @presslabz/e2e e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @presslabz/db generate",
    "db:migrate": "pnpm --filter @presslabz/db migrate",
    "db:reconcile": "pnpm --filter @presslabz/api db:reconcile",
    "db:upgrade": "pnpm db:migrate && pnpm db:reconcile",
    "db:studio": "pnpm --filter @presslabz/db studio",
    "storage:init": "pnpm --filter @presslabz/api storage:init",
    "seed": "pnpm --filter @presslabz/api seed",
    "seed:demo": "pnpm --filter @presslabz/api seed:demo",
    "seed:bulk": "pnpm --filter @presslabz/api seed:bulk",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
