{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["SITE_URL", "DEFAULT_LOCALE", "SUPPORTED_LOCALES", "WEB_HOST", "WEB_PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "DATABASE_URL",
        "VALKEY_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "MEDIA_BASE_URL",
        "SITE_URL",
        "WEB_HOST",
        "WEB_PORT",
        "ADMIN_ORIGIN",
        "DEFAULT_LOCALE",
        "SUPPORTED_LOCALES",
        "API_HOST",
        "API_PORT",
        "CLIENT_IP_SOURCE",
        "TRUSTED_PROXIES",
        "CLIENT_IP_HEADER",
        "IPV6_RATE_LIMIT_PREFIX",
        "RATE_LIMIT_NAMESPACE",
        "HTTP_SOCKET_IDLE_TIMEOUT_MS",
        "HTTP_HEADERS_TIMEOUT_MS",
        "HTTP_REQUEST_TIMEOUT_MS",
        "HTTP_HANDLER_TIMEOUT_MS",
        "HEALTH_CHECK_TIMEOUT_MS"
      ]
    }
  }
}
