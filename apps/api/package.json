{
  "name": "@presslabz/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "seed": "node --env-file-if-exists=../../.env scripts/seed/administrator.ts",
    "seed:demo": "node --env-file-if-exists=../../.env scripts/seed/demo.ts",
    "seed:bulk": "node --env-file-if-exists=../../.env scripts/seed/bulk.ts",
    "typecheck": "tsc --noEmit",
    "check:native": "node --env-file-if-exists=../../.env scripts/native-load-check.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/proxy-addr": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@presslabz/blocks": "workspace:*",
    "@presslabz/cache": "workspace:*",
    "@presslabz/core": "workspace:*",
    "@presslabz/db": "workspace:*",
    "@presslabz/i18n": "workspace:*",
    "@presslabz/modules": "workspace:*",
    "@presslabz/tokens": "workspace:*",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "iovalkey": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
