---
import { createBuiltinRegistry } from '@presslabz/core'
import { createTranslator } from '@presslabz/i18n'
import type { ArchiveView, DocumentView, PageHead, TranslationLink } from '@presslabz/theme-kit'
import {
  loadAncestry,
  loadArchive,
  loadDocument,
  loadMedia,
  loadTranslations,
} from '../../data/content.ts'
import { env, localeConfig } from '../../env.ts'
import {
  archivePath,
  documentPath,
  PAGE_PARAM,
  parsePageNumber,
  parseSegments,
  resolveRoute,
} from '../../lib/routes.ts'
import {
  documentHead,
  listingHead,
  listingTranslations,
  MISSING_HEAD,
  translationLinks,
} from '../../lib/seo.ts'
import { archiveView, documentView, siteContext } from '../../lib/view.ts'
import { theme } from '../../theme.ts'

/**
 * Every public URL under a locale. The route is resolved from the declared
 * content types, the data is loaded, and the theme is handed a finished view —
 * this file never renders anything itself.
 */
type View =
  | { readonly kind: 'missing' }
  | { readonly kind: 'archive'; readonly archive: ArchiveView }
  | {
      readonly kind: 'document'
      readonly document: DocumentView
      readonly head: PageHead
      readonly translations: readonly TranslationLink[]
    }

const registry = createBuiltinRegistry()
const locale = Astro.locals.locale
const segments = parseSegments(Astro.params.path ?? '')
const route = locale && segments ? resolveRoute(registry, segments) : null

let view: View = { kind: 'missing' }

if (locale && route?.kind === 'archive') {
  const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM))
  const archive = page === null ? null : await loadArchive({ type: route.type, locale, page })

  /*
   * A page number past the end is a 404, not an empty list. An archive that
   * answers 200 for every number has an unbounded set of URLs that all say
   * nothing, and each one is a cache entry and a crawl.
   */
  view =
    archive && archive.page <= archive.pageCount
      ? {
          kind: 'archive',
          archive: await archiveView({
            locale,
            type: route.type,
            rows: archive.rows,
            page: archive.page,
            pageCount: archive.pageCount,
            title: createTranslator(locale)(`content.type.${route.type.name}.plural` as never),
          }),
        }
      : { kind: 'missing' }
}

if (locale && route?.kind === 'document') {
  const row = await loadDocument({ type: route.type, locale, slug: route.slug })

  if (row) {
    /*
     * A flat type is its own path. A nesting one has to resolve its ancestors
     * before it has a URL at all: an incomplete chain — a cycle, or a parent
     * in another language — would put the document at a path that is not its
     * own, so it answers 404 rather than picking a plausible one.
     */
    const ancestry = await loadAncestry(row, route.type)
    const path = route.type.hierarchical ? (ancestry?.complete ? ancestry.slugs : null) : [row.slug]

    if (path !== null) {
      const canonical = documentPath(locale, route.type, path)

      if (canonical !== Astro.url.pathname) {
        /*
         * 301 rather than rendering it here. A nested page is reachable by its
         * slug alone — the unique index is (type, locale, slug) — so without
         * this, one document answers at every prefix somebody guesses: a URL
         * to index and a cache entry to purge for each of them.
         */
        return Astro.redirect(canonical, 301)
      }

      const siblings = await loadTranslations(row, route.type)

      view = {
        kind: 'document',
        document: await documentView(row, route.type, path, await loadMedia(row, locale)),
        head: documentHead({ locale, type: route.type, path, meta: row.meta, siblings }),
        translations: translationLinks(siblings, route.type, locale, env.SITE_NAME),
      }
    }
  }
}

if (view.kind === 'missing') Astro.response.status = 404

const site = siteContext({
  locale: locale ?? localeConfig.defaultLocale,
  path: Astro.url.pathname,
  registry,
  head:
    view.kind === 'document'
      ? view.head
      : view.kind === 'archive'
        ? listingHead(Astro.url.pathname)
        : MISSING_HEAD,
  translations:
    view.kind === 'document'
      ? view.translations
      : view.kind === 'archive' && locale
        ? listingTranslations(Astro.url.pathname, locale)
        : [],
  /*
   * A type at the locale root has no archive and therefore no feed; a page is
   * not something a reader subscribes to.
   */
  feedHref:
    locale && route && route.type.basePath !== ''
      ? `${archivePath(locale, route.type)}/feed.xml`
      : null,
})

const Archive = theme.templates.archive
const Document = theme.templates.document
const NotFound = theme.templates.notFound
---

{
  view.kind === 'archive' ? (
    <Archive site={site} archive={view.archive} />
  ) : view.kind === 'document' ? (
    <Document site={site} document={view.document} />
  ) : (
    <NotFound site={site} />
  )
}
