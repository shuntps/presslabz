---
import { createBuiltinRegistry } from '@presslabz/core'
import { loadArchive } from '../../data/content.ts'
import { localeConfig } from '../../env.ts'
import { primaryType } from '../../lib/routes.ts'
import { archiveView, siteContext } from '../../lib/view.ts'
import { theme } from '../../theme.ts'

const registry = createBuiltinRegistry()
const locale = Astro.locals.locale
const type = primaryType(registry)

/*
 * A site context exists even when the request is a miss, because the theme's
 * 404 template is a page like any other: it needs the language, the site name
 * and a way home.
 */
const site = siteContext({
  locale: locale ?? localeConfig.defaultLocale,
  path: Astro.url.pathname,
  registry,
})

const archive = locale && type ? await loadArchive({ type, locale, page: 1 }) : null

const view =
  archive && type && locale
    ? archiveView({
        locale,
        type,
        rows: archive.rows,
        page: archive.page,
        pageCount: archive.pageCount,
        title: site.t('web.home.latest'),
      })
    : null

if (!view) Astro.response.status = 404

const Home = theme.templates.home
const NotFound = theme.templates.notFound
---

{view ? <Home site={site} archive={view} /> : <NotFound site={site} />}
