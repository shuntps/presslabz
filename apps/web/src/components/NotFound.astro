---
import { createTranslator, type Locale } from '@presslabz/i18n'
import Base from '../layouts/Base.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = createTranslator(locale)

/*
 * The status is set here rather than by whoever rendered this, so a page that
 * found nothing cannot answer 200 with an apology in the body — which is what
 * makes a search engine index the apology.
 */
Astro.response.status = 404
---

<Base locale={locale} title={t('web.notFound.title')}>
  <main>
    <h1 class="pl-title">{t('web.notFound.title')}</h1>
    <p>{t('web.notFound.body')}</p>
    <p><a href={`/${locale}`}>{t('web.notFound.home')}</a></p>
  </main>
</Base>
