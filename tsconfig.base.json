{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Node 24 strips types at runtime, so nothing is emitted anywhere and
    // imports carry their .ts extension exactly as written.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The other half of that: the type checker refuses the syntax Node cannot
    // strip — parameter properties, enums, namespaces — instead of accepting
    // what would then fail to load at boot. The runtime check in
    // apps/api/scripts is what proves the graph itself loads.
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
