{
  "name": "@presslabz/cache",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./astro": "./src/astro/config.ts",
    "./astro/runtime": "./src/astro/runtime.ts"
  },
  "//": "Tag-based invalidation is core, not a plugin. The site collects tags while it renders and the API purges them when content changes; both halves are defined here so neither can invent a tag the other does not recognise.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "iovalkey": "catalog:"
  },
  "devDependencies": {
    "@presslabz/db": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
