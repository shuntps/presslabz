---
import { LOCALE_LABELS, LOCALE_TAGS } from '@presslabz/i18n'
import type { SiteContext } from '@presslabz/theme-kit'
import ThemeHead from '@presslabz/theme-kit/ThemeHead.astro'
import ThemeToggle from '@presslabz/theme-kit/ThemeToggle.astro'
import '../tokens.css'

interface Props {
  site: SiteContext
  title: string
  description?: string | undefined
}

const { site, title, description } = Astro.props
---

<html lang={LOCALE_TAGS[site.locale]}>
  <head>
    <ThemeHead site={site} title={title} description={description} />
  </head>
  <body>
    <header>
      <a class="wordmark" href={site.homeHref}>{site.siteName}</a>
      <div class="rails">
        {
          site.nav.length > 0 ? (
            <nav aria-label={site.t('web.nav.label')}>
              {site.nav.map((link) => (
                <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
          ) : null
        }
        {
          /*
           * Only translations that exist. A switcher that lists every language
           * the site runs and sends the reader to a home page when the article
           * has no translation looks helpful and loses their place.
           */
          site.translations.length > 0 ? (
            <nav aria-label={site.t('web.nav.languages')} class="languages">
              {site.translations.map((translation) => (
                <a
                  href={translation.href}
                  lang={translation.locale}
                  hreflang={translation.locale}
                  class:list={{ elsewhere: !translation.available }}
                  title={translation.available ? undefined : site.t('web.nav.untranslated')}
                >
                  {LOCALE_LABELS[translation.locale]}
                </a>
              ))}
            </nav>
          ) : null
        }

        <ThemeToggle
          label={site.t('web.theme.label')}
          options={{
            light: site.t('web.theme.light'),
            dark: site.t('web.theme.dark'),
            system: site.t('web.theme.system'),
          }}
        />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{site.siteName}</p>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Mobile-first, and correct at 320px before any query is written. There is
   * no max-width query anywhere in this project: mixing the two directions
   * produces rules that contradict each other at the boundary.
   */
  body {
    margin: 0;
    background: var(--pl-color-bg);
    color: var(--pl-color-text);
    font-family: var(--pl-font-machine);
    line-height: var(--pl-line-normal);
    /* Keeps content out from under a phone's notch and home indicator. */
    padding-inline: var(--pl-safe-right) var(--pl-safe-left);
  }

  a {
    color: inherit;
  }
</style>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pl-space-4);
    align-items: baseline;
    justify-content: space-between;
    background: var(--pl-color-bg-subtle);
    border-block-end: 1px solid var(--pl-color-border);
    padding: var(--pl-space-4) var(--pl-gutter);
  }

  .wordmark {
    font-family: var(--pl-font-content);
    font-size: var(--pl-text-xl);
    text-decoration: none;
  }

  .rails {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--pl-space-4) var(--pl-space-6);
  }

  nav {
    display: flex;
    gap: var(--pl-space-4);
    font-size: var(--pl-text-sm);
  }

  .languages a {
    font-family: var(--pl-font-data);
    font-size: var(--pl-text-xs);
  }

  /*
   * A language that has no version of this page still gets a link, so the
   * reader is never stuck — but it is marked, because it leads somewhere else.
   */
  .languages a.elsewhere {
    color: var(--pl-color-text-faint);
    text-decoration-style: dotted;
  }

  nav a[aria-current='page'] {
    /* The rubricator's mark, not a fill: colour marks, it never fills. */
    text-decoration-color: var(--pl-color-rubric);
    text-underline-offset: 0.25em;
  }

  main {
    max-width: var(--pl-layout-max);
    margin-inline: auto;
    padding: var(--pl-section) var(--pl-gutter);
  }

  footer {
    border-block-start: 1px solid var(--pl-color-border);
    padding: var(--pl-space-6) var(--pl-gutter);
    color: var(--pl-color-text-muted);
    font-size: var(--pl-text-sm);
  }

  footer p {
    margin: 0;
    max-width: var(--pl-layout-max);
    margin-inline: auto;
  }
</style>
