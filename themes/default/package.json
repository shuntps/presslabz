{
  "name": "@presslabz/theme-default",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "//": "The theme PressLabz ships with, and the reference for writing another one. It is an ordinary consumer of @presslabz/theme-kit with no privileged path into the site \u2014 the same reasoning as the built-in content types.",
  "exports": {
    ".": "./src/theme.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@presslabz/i18n": "workspace:*",
    "@presslabz/theme-kit": "workspace:*"
  },
  "peerDependencies": {
    "astro": "catalog:"
  },
  "devDependencies": {
    "@presslabz/tokens": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
