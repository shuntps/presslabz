# Copy to .env for local development. Never commit .env.
# These defaults match docker-compose.yml and are development-only.

# The API loads this file as its process environment, and NODE_ENV describes
# that process: it is what makes the API log at info and leave the session
# cookie non-secure locally. In production it comes from the deployment — a
# unit file, a container — not from here.
#
# It is NOT the admin build's mode. The admin reads only VITE_-prefixed values
# from this file; its build sets its own NODE_ENV before Vite starts, because
# a build that took `development` from here would ship React's development
# build (see apps/admin/scripts/build.ts).
NODE_ENV=development

# Postgres
POSTGRES_USER=presslabz
POSTGRES_PASSWORD=presslabz
POSTGRES_DB=presslabz
POSTGRES_PORT=5432
DATABASE_URL=postgres://presslabz:presslabz@localhost:5432/presslabz

# Valkey
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

# Object storage (MinIO locally, S3-compatible in production)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=presslabz-media
S3_ACCESS_KEY_ID=presslabz
S3_SECRET_ACCESS_KEY=presslabz-dev-secret
# Where readers fetch media from. In production this is the CDN in front of
# the bucket, not the endpoint the API writes to. Defaults to the two above.
# MEDIA_BASE_URL=https://media.example.com

# API
API_HOST=127.0.0.1
API_PORT=3000

# Origins allowed to send credentialed requests: exact, comma-separated, never
# a wildcard. CORS compares scheme, host and port, so http://localhost:5173 and
# http://127.0.0.1:5173 are two different origins.
#
# Use ONE hostname end to end. The two coherent local configurations are:
#
#   localhost (the default)          127.0.0.1
#     ADMIN_ORIGIN=http://localhost:5173     ADMIN_ORIGIN=http://127.0.0.1:5173
#     VITE_API_URL=http://localhost:3000     VITE_API_URL=http://127.0.0.1:3000
#
# Mixing them does not work, and allowing both origins does not fix it: the
# session cookie is SameSite=Lax, and localhost and 127.0.0.1 are different
# sites, so a fetch from one to the other would not carry the cookie even with
# CORS satisfied. Pick a name and use it in the browser, in ADMIN_ORIGIN and in
# VITE_API_URL.
ADMIN_ORIGIN=http://localhost:5173

# Where the admin sends its requests. Read by Vite from this file, in
# development and at build time, and SUBSTITUTED INTO THE BUNDLE: it is public
# by construction, and it is fixed once a bundle or an image is built. Changing
# it for a built artifact means building again — there is no runtime override.
# Only VITE_-prefixed variables are exposed to the client, which is why nothing
# else in this file is. Defaults to http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Where the client's address comes from. Unset means `socket`: the address is
# the peer on the connection and no forwarding header is believed. That is the
# right answer for a direct installation, and the default for a reason — with
# anything looser, a client reaching the API directly picks its own address,
# and its own rate-limit allowance, by sending a header.
#
#   socket     the connection's peer. Nothing else is read.
#   forwarded  walk X-Forwarded-For against TRUSTED_PROXIES, right to left.
#   header     read CLIENT_IP_HEADER, but only from a declared proxy.
#
# Anything supplied and not applicable refuses to start rather than being
# ignored. Examples:
#
#   Behind nginx/Caddy/HAProxy/a cloud load balancer:
#     CLIENT_IP_SOURCE=forwarded
#     TRUSTED_PROXIES=10.20.0.2,10.20.0.3
#
#   Behind a proxy that publishes one canonical address (Cloudflare's
#   CF-Connecting-IP is one example; nothing here is specific to it):
#     CLIENT_IP_SOURCE=header
#     TRUSTED_PROXIES=10.20.0.2
#     CLIENT_IP_HEADER=CF-Connecting-IP
#
# Addresses and CIDR ranges are both accepted. A range is the right way to
# name a subnet that holds nothing but proxies; what must never be declared is
# one that also holds visitors, applications or untrusted containers — each of
# those would then be trusted to declare a visitor, and in forwarded mode a
# visitor inside the range would be refused as if it were a proxy.
#
# A declared proxy is held to the contract: if it names no usable client, the
# request is answered 400 (missing_forwarded_address), and a value that is not
# a single address is answered 400 (invalid_forwarded_address). Accepting the
# proxy's own address there would give everyone behind it one identity and one
# quota. Nothing is exempt, including a health check sent by the proxy itself.
# A peer that is not a declared proxy keeps its socket address as before.
# CLIENT_IP_SOURCE=socket
# TRUSTED_PROXIES=
# CLIENT_IP_HEADER=

# Rate limiting. Counters live in Valkey, so one quota is one quota across
# every instance. IPv6 clients are grouped by prefix, because a single
# allocation otherwise supplies an endless number of addresses.
# IPV6_RATE_LIMIT_PREFIX=64
# Two installations sharing one Valkey MUST set different values here; nothing
# can detect that automatically.
# RATE_LIMIT_NAMESPACE=presslabz:rl:

# HTTP timeouts, in milliseconds. Four different things:
#   socket idle    inactivity; a transfer that keeps arriving keeps resetting it
#   headers        receiving the request headers
#   request        receiving the whole request
#   handler        the route lifecycle, which is a different thing entirely
#
# 120s over a 20 MiB upload works out at about 170 KiB/s on average. An
# installation accepting large uploads over slow links has to raise it.
#
# The handler timeout is 0 — off — on purpose. Fastify's is cooperative: it
# answers 503 and aborts request.signal, but the work carries on until
# something observes that signal, and nothing here does yet. A positive value
# today would answer 503 while the database write it was meant to stop landed
# anyway, and the client retried.
# HTTP_SOCKET_IDLE_TIMEOUT_MS=60000
# HTTP_HEADERS_TIMEOUT_MS=20000
# HTTP_REQUEST_TIMEOUT_MS=120000
# HTTP_HANDLER_TIMEOUT_MS=0
# How long /health waits for a dependency before reporting it down.
# HEALTH_CHECK_TIMEOUT_MS=2000

# First administrator, created by `pnpm seed`. Change the password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator

# Public site (Astro). The standalone server reads HOST and PORT at runtime;
# these are what `pnpm dev` and the built server use locally.
WEB_HOST=127.0.0.1
WEB_PORT=4321

# The site's own address, used to build canonical URLs, hreflang alternates
# and the sitemap. It must be the address readers actually use, including the
# scheme: an http value behind a TLS-terminating proxy publishes http links.
SITE_URL=http://localhost:4321

# The name readers see in the header and the browser tab.
SITE_NAME=PressLabz

# Locales. DEFAULT_LOCALE must appear in SUPPORTED_LOCALES.
#
# The public site bakes this list into its build, because Astro's i18n routing
# is configured at build time. Narrowing it at runtime is fine; adding a
# language to a built site is refused at boot rather than half-working.
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr
